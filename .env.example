# Prompt Bridge local/recovery configuration template
# Copy to a local secret store or managed environment. Never commit actual values.

# Private server runtime and data
NODE_ENV=development
PORT=3000
DATABASE_URL=
JWT_SECRET=
OAUTH_SERVER_URL=
VITE_APP_ID=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Client-safe Expo public configuration only — do not place secrets here
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_OAUTH_SERVER_URL=
EXPO_PUBLIC_OAUTH_PORTAL_URL=
EXPO_PUBLIC_APP_ID=
EXPO_PUBLIC_OWNER_OPEN_ID=
EXPO_PUBLIC_OWNER_NAME=
EXPO_WEB_PREVIEW_URL=
EXPO_PACKAGER_PROXY_URL=

# OpenAI Platform keys must be configured through the secure server/BYOK flow.
# Never add an OpenAI secret key to this file or a mobile client bundle.
